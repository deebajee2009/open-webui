# Stage 1: Build the frontend
FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /build

# Copy frontend package files and install dependencies
COPY ./package.json ./package-lock.json src/
RUN cd src && npm ci

# Copy the rest of the frontend code and build it
COPY src/ src/
RUN cd src && npm run build

# Stage 2: Build the backend
FROM python:3.12-slim-bookworm

# Set environment variables
ENV PATH="/root/.local/bin:${PATH}"
ENV PYTHONPATH=/app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Poetry for dependency management
RUN pip install --user poetry

# Set working directory
WORKDIR /app

# Copy Poetry files and install backend dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false && poetry install --only main --no-interaction --no-ansi

# Copy the backend code
COPY backend/ backend/

# Copy the built frontend static files from the previous stage
COPY --from=frontend-builder /build/frontend/dist /app/backend/static

# Expose the port (default is 8080 for the backend)
EXPOSE 8080

# Run the backend server with Uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080", "--forwarded-allow-ips", "*"]
